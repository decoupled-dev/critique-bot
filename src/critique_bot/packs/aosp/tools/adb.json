{
  "name": "adb",
  "description": "Query or change the connected Android device through adb. Read-only actions run without asking: devices, logcat (saved to a file and summarized), getprop, dumpsys, services, packages, ps, settings_get, dmesg. bugreport and pull write a file here and ask. push, install, uninstall, reboot, settings_put and flash change the device and ask every time, also in auto mode. Not for: logs already saved as files (triage or log), building (aosp_build). Example: {\"action\": \"dumpsys\", \"service\": \"car_service\"}. Output: the command's output, capped; logcat returns the saved file's path and a summary of its crashes, ANRs and errors.",
  "read_only": true,
  "timeout_s": 60,
  "output_cap_tokens": 4000,
  "taint": "device",
  "parameters": {
    "type": "object",
    "properties": {
      "action": {"type": "string", "enum": ["devices", "logcat", "getprop", "dumpsys", "services", "packages", "ps", "settings_get", "dmesg", "bugreport", "pull", "push", "install", "uninstall", "reboot", "settings_put", "flash"]},
      "serial": {"type": "string", "description": "device serial when several are connected (adb devices)"},
      "lines": {"type": "integer", "minimum": 10, "maximum": 50000, "description": "logcat: newest lines to dump (default 5000)"},
      "buffer": {"type": "string", "enum": ["default", "all", "main", "system", "crash", "events", "radio", "kernel"], "description": "logcat buffer (default: main, system, crash)"},
      "filter": {"type": "string", "description": "logcat filterspecs, e.g. 'CarService:V *:S'"},
      "name": {"type": "string", "description": "getprop: one property, e.g. ro.build.fingerprint"},
      "service": {"type": "string", "description": "dumpsys: the service, e.g. car_service, activity, window"},
      "package": {"type": "string", "description": "packages: name filter; uninstall: the package"},
      "namespace": {"type": "string", "enum": ["system", "secure", "global"], "description": "settings namespace"},
      "key": {"type": "string", "description": "settings key"},
      "value": {"type": "string", "description": "settings_put: the new value"},
      "remote": {"type": "string", "description": "pull/push: the path on the device"},
      "local": {"type": "string", "description": "pull/push: the path in the workspace"},
      "apk": {"type": "string", "description": "install: the APK, relative to the workspace (e.g. out/target/product/x/system/app/Foo/Foo.apk)"},
      "target": {"type": "string", "enum": ["system", "bootloader", "recovery", "fastboot"], "description": "reboot into (default: system)"},
      "partition": {"type": "string", "description": "flash: the partition, e.g. vendor_boot"},
      "image": {"type": "string", "description": "flash: the image file in the workspace"}
    }
  },
  "run": {"env": {"ANDROID_SERIAL": "{serial}"}},
  "actions": {
    "devices": {"argv": ["adb", "devices", "-l"], "taint": "trusted"},
    "logcat": {"argv": ["adb", "logcat", "-d", "-v", "threadtime", "-b", "{buffer|default}", "-t", "{lines|5000}", "{filter}"],
               "handler": "adb_logcat", "timeout_s": 120,
               "patterns": {"filter": "[A-Za-z0-9_.*:/]{1,80}(?: [A-Za-z0-9_.*:/]{1,80}){0,15}"}},
    "getprop": {"argv": ["adb", "shell", "getprop", "{name}"], "patterns": {"name": "[A-Za-z0-9_.-]{1,120}"}},
    "dumpsys": {"argv": ["adb", "shell", "dumpsys", "{service}"], "required": ["service"], "timeout_s": 120,
                "patterns": {"service": "[A-Za-z0-9_./@-]{1,120}"}},
    "services": {"argv": ["adb", "shell", "dumpsys", "-l"]},
    "packages": {"argv": ["adb", "shell", "pm", "list", "packages", "-f", "{package}"], "patterns": {"package": "[A-Za-z0-9_.]{1,200}"}},
    "ps": {"argv": ["adb", "shell", "ps", "-A", "-o", "PID,PPID,USER,STAT,NAME"]},
    "settings_get": {"argv": ["adb", "shell", "settings", "get", "{namespace}", "{key}"], "required": ["namespace", "key"],
                     "patterns": {"key": "[A-Za-z0-9_.]{1,120}"}},
    "dmesg": {"argv": ["adb", "shell", "dmesg"]},
    "bugreport": {"argv": ["adb", "bugreport", "{local|bugreport.zip}"], "read_only": false, "timeout_s": 900,
                  "patterns": {"local": "(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./@+-]{1,300}\\.zip"}},
    "pull": {"argv": ["adb", "pull", "{remote}", "{local}"], "read_only": false, "required": ["remote", "local"], "timeout_s": 300,
             "patterns": {"remote": "/[A-Za-z0-9_./@+-]{1,300}", "local": "(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./@+-]{1,300}"}},
    "push": {"argv": ["adb", "push", "{local}", "{remote}"], "device": true, "required": ["local", "remote"], "timeout_s": 300,
             "patterns": {"remote": "/[A-Za-z0-9_./@+-]{1,300}", "local": "(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./@+-]{1,300}"}},
    "install": {"argv": ["adb", "install", "-r", "{apk}"], "device": true, "required": ["apk"], "timeout_s": 300,
                "patterns": {"apk": "(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./@+-]{1,300}\\.apk"}},
    "uninstall": {"argv": ["adb", "uninstall", "{package}"], "device": true, "required": ["package"],
                  "patterns": {"package": "[A-Za-z0-9_.]{1,200}"}},
    "reboot": {"argv": ["adb", "reboot", "{target}"], "device": true, "patterns": {"target": "bootloader|recovery|fastboot"}},
    "settings_put": {"argv": ["adb", "shell", "settings", "put", "{namespace}", "{key}", "{value}"], "device": true,
                     "required": ["namespace", "key", "value"],
                     "patterns": {"key": "[A-Za-z0-9_.]{1,120}", "value": "[A-Za-z0-9_.:,/+@-]{0,200}"}},
    "flash": {"argv": ["fastboot", "flash", "{partition}", "{image}"], "device": true, "required": ["partition", "image"], "timeout_s": 600,
              "patterns": {"partition": "[a-z0-9_]{1,40}", "image": "(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./@+-]{1,300}\\.img"}}
  },
  "examples": [
    {"args": {"action": "devices"}, "expect_ok": true},
    {"args": {"action": "getprop", "name": "x; reboot"}, "expect_ok": false},
    {"args": {"action": "dumpsys", "service": "--help"}, "expect_ok": false}
  ]
}
