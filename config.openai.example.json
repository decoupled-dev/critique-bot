{
  "backend": "openai",
  "model": "gpt-4o",
  "base_url": "https://api.openai.com/v1",
  "api_key_env": "OPENAI_API_KEY",
  "timeout_ms": 180000,
  "max_prompt_chars": 120000,
  "max_file_chars": 32000,
  "max_files": 80,
  "max_read_bytes": 16000000,
  "queue_dir": ".critique-queue",
  "min_interval_seconds": 5,
  "interval_jitter_seconds": 2,
  "max_parallel_tabs": 1
}
