[Unit]
Description=critique-bot review worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/critique-bot
ExecStart=/opt/critique-bot/critique-bot worker --config /opt/critique-bot/config.json --logs
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

# Uncomment and set a dedicated user that owns the Edge profile:
# User=gitlab-runner
# Group=gitlab-runner

[Install]
WantedBy=multi-user.target
