[Unit]
Description=critique-bot review worker
After=network-online.target
Wants=network-online.target

# The worker runs as its own user, never as the GitLab runner user: CI jobs run
# whatever a branch's .gitlab-ci.yml says, and must not be able to read the
# signed-in browser profile (SSO cookies), processing/ jobs, or the token.
# One-time setup (see DEPLOY.md, "CI runner (GitLab)"):
#
#   sudo useradd --system --home-dir /var/lib/critique-bot --create-home \
#        --shell /usr/sbin/nologin critique-bot
#   sudo usermod -aG critique-bot gitlab-runner      # CI may use the queue group
#   sudo install -d -o critique-bot -g critique-bot -m 2750 /var/lib/critique-bot/queue
#   # config.json: "queue_dir": "/var/lib/critique-bot/queue",
#   #              "user_data_dir": "/var/lib/critique-bot/.edge-profile"
#   sudo chown -R root:critique-bot /opt/critique-bot && sudo chmod -R o-rwx /opt/critique-bot
#
# With CRITIQUE_QUEUE_SHARED=1 the worker keeps inbox/ at 2770 (CI writes jobs),
# results/ at 2750 with 0640 status/review files (CI reads them), and
# processing/, failure snapshots, and the browser profile owner-only.

[Service]
Type=simple
User=critique-bot
Group=critique-bot
WorkingDirectory=/opt/critique-bot
ExecStart=/opt/critique-bot/critique-bot worker --config /opt/critique-bot/config.json --logs
Environment=CRITIQUE_QUEUE_SHARED=1
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

# Hardening.
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# The only places the worker writes: its home (profile, queue). Add the folder
# of config.json's queue_dir / user_data_dir here if you keep them elsewhere.
ReadWritePaths=/var/lib/critique-bot
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
# Not set on purpose:
#  - RestrictNamespaces: Chromium's sandbox creates user/PID/network namespaces;
#    restricting them breaks the sandbox (and would push toward --no-sandbox).
#  - MemoryDenyWriteExecute: the V8 JIT in Edge/Chromium needs W+X memory.
#  - PrivateUsers / SystemCallFilter=@system-service: also break the sandbox.
# Never run this unit as root: as root the browser starts without its sandbox.

[Install]
WantedBy=multi-user.target
